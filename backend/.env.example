APP_NAME=Tlearn API
ENVIRONMENT=development
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB_NAME=tlearn
MONGODB_SERVER_SELECTION_TIMEOUT_MS=30000
MONGODB_CONNECT_TIMEOUT_MS=10000
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173

STORAGE_BACKEND=local
GCS_UPLOAD_BUCKET=
GCP_PROJECT_ID=

TASK_QUEUE_BACKEND=local
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=
EXTRACTION_WORKER_URL=
EXTRACTION_WORKER_AUDIENCE=
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT_EMAIL=

OPENAI_API_KEY=replace-this-with-your-openai-api-key
OPENAI_TOPIC_MODEL=gpt-5.4-mini
RESEND_API_KEY=replace-this-with-your-resend-api-key
RESEND_FROM_EMAIL=Tlearn <noreply@example.com>
PASSWORD_RESET_TOKEN_MINUTES=15
